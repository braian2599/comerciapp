# =====================================================================
# Variables de entorno para Comerciapp
# Copiar a .env para desarrollo local.
# En Vercel: configurar las mismas variables en Project Settings > Environment Variables.
# =====================================================================

# --- Base de datos PostgreSQL ---
# URL pooled (con -pooler en el hostname) para runtime serverless de Vercel.
# Soporta conexiones concurrentes de múltiples lambdas sin agotar el pool.
# Neon: pegar de neon.tech dashboard → "Connection String" → "Pooled connection".
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15

# URL directa (sin -pooler) para migraciones Prisma.
# Las migraciones no funcionan a través de pgbouncer (no soporta prepared statements).
# Neon: pegar de neon.tech dashboard → "Connection String" → "Direct connection".
DIRECT_DATABASE_URL=postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- NextAuth (autenticación) ---
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL pública de la app. En Vercel, automáticamente se setea en preview/production,
# pero conviene declararla explícitamente para producción.
# - Producción: https://tu-dominio.vercel.app (o custom domain)
# - Dev local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Token opcional para proteger /api/seed en producción ---
# Si no se setea, /api/seed queda bloqueado en producción.
# Generar con: openssl rand -hex 32
SEED_TOKEN=

# --- Encriptación de secrets en DB (certPassword de AFIP, etc.) ---
# Recomendado: generar con `openssl rand -hex 32` (64 chars hex = 32 bytes).
# Si no se setea, se deriva de NEXTAUTH_SECRET con SHA-256 (aceptable pero
# menos seguro: rotar NEXTAUTH_SECRET rompe la desencriptación).
CERT_PASSWORD_ENCRYPTION_KEY=

# --- Storage de certificados AFIP (S3-compatible) ---
# Soporta: Cloudflare R2, AWS S3, Backblaze B2, MinIO, DigitalOcean Spaces, etc.
#
# Si S3_BUCKET NO se setea, se usa FS local (uploads/afip-certs/).
# Eso es suficiente para dev/self-hosted en un único VPS.
#
# Para Vercel prod, multi-instancia, o Docker sin volúmenes: configurar S3.
#
# Ejemplo Cloudflare R2:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=comerciapp-afip-certs
#   S3_ACCESS_KEY_ID=<r2 access key>
#   S3_SECRET_ACCESS_KEY=<r2 secret>
#   S3_FORCE_PATH_STYLE=false
#
# Ejemplo AWS S3:
#   S3_ENDPOINT=https://s3.us-east-1.amazonaws.com  (o dejar vacío)
#   S3_REGION=us-east-1
#   S3_BUCKET=comerciapp-afip-certs
#   S3_ACCESS_KEY_ID=<iam access key>
#   S3_SECRET_ACCESS_KEY=<iam secret>
#   S3_FORCE_PATH_STYLE=false
#
# Ejemplo MinIO (self-hosted):
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
#   S3_BUCKET=comerciapp-afip-certs
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin
#   S3_FORCE_PATH_STYLE=true
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Directorio local de uploads (solo si S3 no está configurado) ---
# Default: <project_root>/uploads/afip-certs
# En Vercel: /tmp/afip-certs (no persistente, solo para dev)
# En Docker: montar un volumen aquí
# UPLOADS_DIR=/home/z/my-project/uploads/afip-certs

