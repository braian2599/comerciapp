# =====================================================================
# Variables de entorno para Comerciapp
# Copiar a .env para desarrollo local.
# En Vercel: configurar las mismas variables en Project Settings > Environment Variables.
# =====================================================================

# --- Base de datos PostgreSQL ---
# URL pooled (con -pooler en el hostname) para runtime serverless de Vercel.
# Soporta conexiones concurrentes de múltiples lambdas sin agotar el pool.
# Neon: pegar de neon.tech dashboard → "Connection String" → "Pooled connection".
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15

# URL directa (sin -pooler) para migraciones Prisma.
# Las migraciones no funcionan a través de pgbouncer (no soporta prepared statements).
# Neon: pegar de neon.tech dashboard → "Connection String" → "Direct connection".
DIRECT_DATABASE_URL=postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- NextAuth (autenticación) ---
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL pública de la app. En Vercel, automáticamente se setea en preview/production,
# pero conviene declararla explícitamente para producción.
# - Producción: https://tu-dominio.vercel.app (o custom domain)
# - Dev local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Token opcional para proteger /api/seed en producción ---
# Si no se setea, /api/seed queda bloqueado en producción.
# Generar con: openssl rand -hex 32
SEED_TOKEN=
